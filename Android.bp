package {
    default_team: "trendy_team_android_hardware_backed_security",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "mystic.attestation.provisioner",
    local_include_dir: "aidl",
    srcs: [
        "aidl/mystic/attestation/provisioner/AttestationKeyCertificateProfile.aidl",
        "aidl/mystic/attestation/provisioner/IBackendAttestationKeyProvisioner.aidl",
        "aidl/mystic/attestation/provisioner/ProvisionedAttestationKey.aidl",
    ],
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
    },
}

rust_protobuf {
    name: "libdroidfood_attestation_proto_rust",
    crate_name: "droidfood_attestation_proto",
    source_stem: "droidfood_attestation_proto",
    protos: ["proto/overwrite.proto"],
}

rust_dependencies = [
    "android.security.postprocessor-rust",
    "libandroid_logger",
    "libbinder_rs",
    "liblog_rust",
    "libopenssl",
    "libprotobuf",
    "libreqwest",
    "librustutils",
    "libuuid",
    "libdroidfood_attestation_proto_rust",
    "mystic.attestation.provisioner-rust",
]

rust_library {
    name: "libdroidfoodattestation",
    crate_name: "droidfoodattestation",
    srcs: ["src/lib.rs"],
    rustlibs: rust_dependencies,
    defaults: [
        "keymint_use_latest_hal_aidl_rust",
        "keystore2_use_latest_aidl_rust",
    ],
}

rust_binary {
    name: "rkp_cert_processor",
    crate_name: "droidfoodattestation",
    srcs: ["src/main.rs"],
    init_rc: ["droidfoodattestation.rc"],
    rustlibs: rust_dependencies + ["libdroidfoodattestation"],
    prefer_rlib: true, // To avoid dynamic link error.
    bootstrap: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "android.security.postprocessor.init.rc",
    src: "droidfoodattestation.rc",
    filename: "init.rc",
    installable: true,
    system_ext_specific: true,
}
